DJANGO_SECRET_KEY=gere-uma-chave-secreta-para-o-ambiente
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TOTEM_API_KEY=gere-uma-chave-secreta-para-o-totem

# No Render, configure MEDIA_ROOT com o caminho de montagem do Persistent Disk,
# por exemplo: /var/data/media
# MEDIA_ROOT=/var/data/media

# Opcional: use uma URL de banco gerenciada pelo ambiente.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
